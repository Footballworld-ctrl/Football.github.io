<!DOCTYPE html>
<html>
<head>
    <title>예제7-1 translate</title>
    <meta charset="utf-8">

    <style>
        div#trnsXY {
            width: 150px;
            height: 80px;
            background-color: red;

            /* 오른쪽 100px, 아래쪽 200px 이동 */
            transform: translate(100px, 200px);
        }

        div#trnsX {
            width: 150px;
            height: 80px;
            background-color: green;

            /* 오른쪽으로 150px 이동 */
            transform: translateX(150px);
        }

        div#trnsY {
            width: 150px;
            height: 80px;
            background-color: blue;

            /* 아래쪽으로 100px 이동 */
            transform: translateY(100px);
        }
    </style>
</head>

<body>

    <h1>Transform - translate()</h1>

    <div id="trnsXY">translate(100px, 200px)</div>
    <br>

    <div id="trnsX">translateX(150px)</div>
    <br>

    <div id="trnsY">translateY(100px)</div>
    <a href="static.html">
</body>
</html>
